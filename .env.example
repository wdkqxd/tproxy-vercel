# public domain, no scheme/port
TPROXY_HOST=

# generate: openssl rand -hex 32
TPROXY_TOKEN_KEY=

# optional prefix, empty = root
TPROXY_BASE_PATH=

# generate: openssl rand -hex 16 (add dd to start for padding)
TPROXY_SECRET=

# ws poll ms, keep below function maxDuration (recommended: 25000)
TPROXY_LONG_POLL_MS=
